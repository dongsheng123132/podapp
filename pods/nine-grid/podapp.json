{
  "profile": "podapp/pod@0.1",
  "pod": {
    "id": "org.podapp.image.nine-grid",
    "slug": "nine-grid",
    "name": "九宫格切图",
    "version": "0.2.0",
    "summary": "把一张图切成九张，尺寸严丝合缝",
    "description": "AI 常一次画出九宫格拼在一起的图，但发朋友圈 / 小红书要的是九张独立图片。这个程序舱按行列均分切开，可以指定要丢掉的缝宽，切完每张单独交付。不压缩、不重编码尺寸，切多大就是多大。",
    "author": "PodApp",
    "homepage": "https://podapp.net/pods/nine-grid",
    "license": "MIT",
    "locales": ["zh-CN"],
    "min_host_version": "0.1.0"
  },
  "action_parity": "./action-parity.json",
  "package": {
    "kind": "web",
    "web": {
      "root": "web",
      "entry": "index.html",
      "actions": "actions.mjs"
    }
  },
  "ui": {
    "icon": "lucide:grid-3x3",
    "accent": "#49bdd0",
    "container": "window",
    "window": { "width": 900, "height": 680, "resizable": true },
    "home_dock": true,
    "quick_actions": [
      { "action": "app.nine-grid.image.split", "label": "切九宫格", "icon": "lucide:grid-3x3" }
    ]
  },
  "permissions": {
    "ai": {
      "image_generate": false,
      "image_edit": false,
      "chat": false,
      "video_generate": false,
      "max_calls_per_run": 0
    },
    "fs": { "app_data": true, "save_dialog": false, "open_dialog": false },
    "net": { "allow": [] },
    "host_actions": []
  },
  "market": {
    "category": "image",
    "tags": ["切图", "九宫格", "朋友圈", "小红书"]
  }
}

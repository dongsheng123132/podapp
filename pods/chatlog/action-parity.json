{
  "spec_version": "0.5.0",
  "application": { "id": "org.podapp.codex.chatlog", "name": "对话导出", "version": "0.2.1" },
  "surfaces": [
    { "id": "pod", "kind": "gui", "required_for_parity": true },
    { "id": "cli", "kind": "cli", "required_for_parity": true }
  ],
  "actions": [
    {
      "id": "app.chatlog.session.list",
      "title": "列出会话",
      "description": "List recent Codex sessions with a human-readable title, newest first.",
      "input_schema": {
        "type": "object", "additionalProperties": false,
        "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 500 } }
      },
      "output_schema": { "type": "object" },
      "effects": { "class": "read", "risk": "low", "reversible": true, "confirmation": "never", "audit_required": false },
      "execution": { "headless": true, "idempotent": true, "cancellable": false, "timeout_ms": 30000 },
      "bindings": [
        { "surface": "pod", "target": "pod-rpc:action/app.chatlog.session.list" },
        { "surface": "cli", "target": "cli:action run app.chatlog.session.list --json" }
      ]
    },
    {
      "id": "app.chatlog.session.export",
      "title": "导出对话",
      "description": "Export one Codex session to Markdown or HTML. The system prompt is never included. Accepts either a session id or raw JSONL pasted in by the user.",
      "input_schema": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "session": { "type": "string", "minLength": 1, "description": "会话 id 或路径" },
          "jsonl": { "type": "string", "minLength": 1, "description": "兜底：直接给 rollout 文件的内容" },
          "format": { "enum": ["markdown", "html"] },
          "title": { "type": "string", "maxLength": 200 }
        }
      },
      "output_schema": { "type": "object" },
      "effects": { "class": "read", "risk": "low", "reversible": true, "confirmation": "never", "audit_required": false },
      "execution": { "headless": true, "idempotent": true, "cancellable": false, "timeout_ms": 60000 },
      "bindings": [
        { "surface": "pod", "target": "pod-rpc:action/app.chatlog.session.export" },
        { "surface": "cli", "target": "cli:action run app.chatlog.session.export --json" }
      ]
    }
  ]
}

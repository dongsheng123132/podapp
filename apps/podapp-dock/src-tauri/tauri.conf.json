{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "泊舟 AI 小程序",
  "version": "0.2.0",
  "identifier": "org.podapp.dock",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "node ../../scripts/build-sidecars.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dock",
        "title": "泊舟 AI 小程序",
        "width": 170,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://u-claw.org.cn/podapp/latest.json",
        "https://podapp.net/latest.json",
        "https://github.com/dongsheng123132/podapp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRUE4RkIyMTNFNTJDM0YKUldRL0xPVVRzby9xN3hyaS9rb3ZMc3NnUE1DdzJndDdvcDB5ZTZ6d3ZKTEViMXA5NjYrY3IwNE4K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../pods": "pods"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pod"
        ],
        "name": "泊舟 AI 小程序包",
        "description": "可安装、可分享，也能由 AI 直接调用的小程序包",
        "role": "Editor"
      }
    ],
    "externalBin": [
      "binaries/podapp-mcp"
    ]
  }
}
